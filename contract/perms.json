    "plug": {
      "actions": [
        "read",
        "write"
      ],
      "resources": [
        "plug:in",
        "plug:out",
        "station:voice:out",
        "station:motion:out"
      ]
    },
    "claude": {
      "actions": [
        "read",
        "run",
        "door:accept",
        "sign"
      ],
      "resources": [
        "door:intake",
        "door:signal",
        "door:plug",
        "station:*",
        "lot:*",
        "sock:*"
      ]
    },
    "deepseek": {
      "actions": [
        "read",
