      "resources": [
        "*"
      ]
    },
    "runner": {
      "actions": [
        "read",
        "write",
        "publish",
        "run",
        "door:accept",
        "sign"
      ],
      "resources": [
        "station:*",
        "lot:*",
        "hq",
        "door:*",
        "sock:*",
        "factory"
      ]
    },
    "reader": {
      "actions": [
        "read"
      ],
      "resources": [
        "public:book",
        "public:profile",
        "public:showroom",
        "station:book"
      ]
