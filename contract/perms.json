  "actors": {
    "owner": "계정 주인 — 서랍 읽기·쓰기, 공개 승인, 발행, 플러그, 일시정지",
    "runner": "자동화(공장 러너) — 승인은 못 한다(사람 경계). 서랍 읽기·쓰기, 발행, 회전",
    "reader": "독자 — 공개 표면 읽기만",
    "plug": "플러그 — 자기 소켓 입·출력만",
    "claude": "개발 에이전트 — 주문(intake · plug · run)만. 서랍 쓰기 없음",
    "deepseek": "시험 에이전트 — 주문(intake · run)만. 서랍 쓰기 없음"
  },
  "allow": {
