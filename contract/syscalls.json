      "args": {
        "title": "str",
        "text": "str(≤200000)",
        "llm": "str"
      },
      "effect": "01 inbox raw/ 에 대화 넣기 → 회전"
    },
    "approve": {
      "args": {
        "lot": "lot"
      },
      "effect": "04 approved.txt 에 올림 → 회전(공개)"
    },
    "hold": {
      "args": {
        "lot": "lot"
      },
      "effect": "04 approved.txt 에서 뺌(다음 회전부터 비공개)"
    },
    "verdict": {
      "args": {
        "lot": "lot",
        "verdict": "OK|NO",
        "codes": "[E-…]",
        "memo": "str"
      },
      "effect": "본사 contract/eval.cases.jsonl(골든셋)"
    },
    "plug": {
      "args": {
        "action": "add|remove",
        "name": "plugs.json 이름",
        "route": "switch|local"
      },
      "effect": "02 변수 WORLD_PLUGS"
    },
    "recipe": {
      "args": {
        "key": "recipe.json 의 점 경로(허용 목록)",
        "value": "number|str"
      },
      "effect": "본사 recipe.json"
    },
    "run": {
      "args": {},
      "effect": "공장 한 바퀴(world-run)"
    },
    "halt": {
      "args": {
        "reason": "str"
      },
      "effect": "본사 status/HALT — 라인 정지(인터럽트). 회전 · 게시가 멈춘다"
    },
    "resume": {
      "args": {},
      "effect": "HALT 해제"
    },
    "forget": {
      "args": {
        "lot": "lot"
      },
      "effect": "원장 · 원자 · 05 공개 · 색인 · 사본 · 성적서 · 출하 릴리스에서 회수 — journal/forget.jsonl · 다음 사본부터 제외(관문 forgotten.txt)"
    },
    "schedule": {
      "args": {
        "action": "add|remove",
        "name": "2~24자",
        "every": "daily|weekly|monthly",
        "job": "run|digest"
      },
      "effect": "본사 contract/schedules.json — 주인이 정하는 반복 작업(매일 07:00 KST schedule 워크플로가 실행)"
    }
  },
  "recipe_keys": [
