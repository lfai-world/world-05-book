{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "lfai-world/manifest v1",
 "title": "LFAI WORLD 조립표 (customer.manifest.json)",
 "type": "object",
 "required": ["schema", "customer", "owner", "book_title", "plan", "nuts", "plugs", "mcp"],
 "properties": {
  "schema": {"const": "lfai-world/manifest v1"},
  "customer": {"type": "string", "minLength": 1},
  "owner": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,38}$"},
  "prefix": {"const": "world"},
  "public": {"type": "array", "items": {"type": "string"}, "minItems": 2},
  "book_title": {"type": "string", "minLength": 1},
  "plan": {"enum": ["free", "pro"]},
  "nuts": {"type": "object", "additionalProperties": {}},
  "plugs": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "route": {"enum": ["switch", "local"]}}}},
  "mcp": {"type": "array", "items": {"type": "string"}},
  "recipe": {"type": "object", "additionalProperties": {"type": ["number", "string", "array"]}},
  "schedule": {"type": "object", "additionalProperties": {}},
  "notify": {"enum": ["telegram", "none"]},
  "council_candidates": {"type": "array", "items": {"type": "string"}},
  "interview_at": {"type": "string"},
  "by": {"type": "string"}
 },
 "additionalProperties": true
}
