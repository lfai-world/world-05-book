    "class": {"station": "WC-09", "path": "world-09-class/<lot>.md · .html", "spec": {"sections": ["학습 목표", "핵심", "본문", "확인 질문", "토론 질문"]}},
    "press": {"station": "WC-10", "path": "world-10-press/<lot>.md", "spec": {"channels": ["X · Threads", "블로그 · 페이스북", "카카오톡 · 문자"]}}
  }
